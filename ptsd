#!/usr/bin/env bash
# PTSD Agent Wrapper Script
# Activates the ptsd_agent venv and runs the agent from any directory

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Path to the virtual environment and source directory
VENV_DIR="$SCRIPT_DIR/.venv"
PYTHON_BIN="$VENV_DIR/bin/python"
SRC_DIR="$SCRIPT_DIR/src"

# Check if venv exists
if [ ! -f "$PYTHON_BIN" ]; then
    echo "Error: Virtual environment not found at $VENV_DIR"
    echo "Please create it first with: python -m venv .venv && pip install -r requirements.txt"
    exit 1
fi

# Check if src directory exists
if [ ! -d "$SRC_DIR" ]; then
    echo "Error: Source directory not found at $SRC_DIR"
    exit 1
fi

# Run ptsd_agent with explicit sys.path manipulation
# This ensures the src directory is properly added to the module search path
exec "$PYTHON_BIN" -c "import sys; sys.path.insert(0, '$SRC_DIR'); from ptsd_agent.cli.legacy_main import main; main()" "$@"
